# Copy this file to .env (same folder) and fill in the values.  .env is git-ignored; never commit it.
# A variable already set in Windows wins over this file; a command-line flag wins over both.

# PostgreSQL connection (read by psycopg2/libpq)
PGHOST=your-db-host
PGPORT=5432
PGDATABASE=your_db
PGUSER=your_user
PGPASSWORD=your_password
# PGSSLMODE=require

# Source tables, [schema.]table
CCDA_DEMO_TABLE=pcw.memberdemo
CCDA_CROSSWALK_TABLE=pcw.idcrosswalk
CCDA_ENCOUNTER_TABLE=pcw.encounternotes
CCDA_DIAGNOSIS_TABLE=pcw.visitdiagnosis
CCDA_LAB_TABLE=pcw.internallab

# Output folder; XML goes to <CCDA_OUT_DIR>\<RGN_CD>\<mrn_padded>.xml
CCDA_OUT_DIR=C:\data\PCW_ccda
