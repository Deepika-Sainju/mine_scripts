# --- AWS (S3 file bucket, read-only) -----------------------------------------
AWS_REGION=us-east-1
# Credentials: leave blank to use an instance role / SSO profile / AWS_PROFILE.
# Only set these for static keys (or export STS creds in the shell instead).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # required if the creds above are temporary/STS
